{
  "id": "/app",
  "name": "Webklip",
  "short_name": "Webklip",
  "description": "Lightweight internet clipboard with real-time sync",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eef5f3",
  "theme_color": "#0f766e",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "__BASE__/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "__BASE__/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "__BASE__/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/new",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "text/*", "*/*"]
        }
      ]
    }
  }
}
